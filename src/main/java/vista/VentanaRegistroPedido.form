            </properties>
          </component>
          <component id="7ada8" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Tipo"/>
            </properties>
          </component>
          <component id="d349a" class="javax.swing.JTextField" binding="txtDireccion">
