              <grid row="0" column="2" row-span="1" col-span="3" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="250" height="30"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="64e7f" class="javax.swing.JComboBox" binding="comboBox1Tipo">
